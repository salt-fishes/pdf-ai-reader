# 复制此文件为 .env，并填入真实密钥。不要提交 .env。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
# 可选：允许前端切换的模型（逗号分隔）。留空则只能使用 AI_MODEL。
AI_MODEL_ALLOW=
# 本地演示：1 = 使用内置 mock 流式回答，不调用真实模型。
MOCK_AI=0
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173

# 可选 OCR：默认从 GitHub 下载 PP-OCRv6 tiny（约 6MB）。
# 国内网络慢可换成镜像前缀，或在 OCR_MODEL_DIR 预放 det.onnx / rec.onnx / dict.txt。
OCR_MODEL_BASE_URL=
OCR_MODEL_DIR=

# 可选：可写数据目录（provider 配置）。桌面版由 Electron 指向 userData。
PDF_AI_DATA_DIR=

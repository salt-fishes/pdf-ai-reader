{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"],
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["tests/e2e", "playwright.config.ts"]
}

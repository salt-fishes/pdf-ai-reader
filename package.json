{
  "name": "pdf-ai-reader",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "description": "Local-first PDF reader with an AI reading assistant",
  "main": "electron/main.mjs",
  "license": "MIT",
  "author": "Paper Reader contributors",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pdf",
    "pdfjs",
    "ai",
    "reader",
    "local-first",
    "electron"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/src/index.ts",
    "dev:server:watch": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=server/dist/index.mjs --external:onnxruntime-node --external:ppu-paddle-ocr --banner:js=\"import { createRequire as __bundleRequire } from 'node:module'; const require = __bundleRequire(import.meta.url);\" && esbuild server/src/ocrWorker.ts --bundle --platform=node --format=esm --target=node22 --outfile=server/dist/ocr-worker.mjs --external:onnxruntime-node --external:ppu-paddle-ocr",
    "desktop:dev": "node electron/dev.mjs",
    "desktop": "npm run build && npm run build:server && electron .",
    "build:desktop": "npm run build && npm run build:server && electron-builder --win --x64 --publish never",
    "build:desktop:dir": "npm run build && npm run build:server && electron-builder --win --x64 --dir --publish never",
    "build:installers": "npm run build && npm run build:server && electron-builder --win nsis msi --x64 --publish never",
    "package:desktop": "npm run build && npm run build:server && node scripts/package-desktop.mjs",
    "package:ocr-pack": "node scripts/package-ocr-pack.mjs",
    "preview": "vite preview",
    "start": "node --import tsx server/src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-real.mjs",
    "smoke:ui": "node scripts/smoke-real-ui.mjs",
    "smoke:smart": "node scripts/smoke-real-smart.mjs",
    "smoke:region": "node scripts/smoke-real-region.mjs",
    "smoke:vision": "node scripts/smoke-real-vision.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:version": "node scripts/check-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@lobehub/icons-static-svg": "1.102.0",
    "adm-zip": "0.6.1",
    "dotenv": "17.2.3",
    "hono": "4.13.18",
    "idb-keyval": "6.3.0",
    "katex": "0.19.1",
    "lucide": "1.73.0",
    "onnxruntime-node": "^1.31.1",
    "pdfjs-dist": "6.5.438",
    "ppu-paddle-ocr": "^6.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "4.23.15",
    "undici": "7.30.2",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "9.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.10.1",
    "rcedit": "^5.0.1",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "cn.paperreader.app",
    "productName": "纸间",
    "artifactName": "paper-reader-v${version}-${arch}.${ext}",
    "asar": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/samples/**",
      "server/dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ],
      "icon": "build/icon.ico",
      "executableName": "PaperReader",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "纸间",
      "include": "installer.nsh"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "纸间",
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "additionalLightArgs": [
        "-loc",
        "../../build/zh-CN.wxl"
      ]
    },
    "portable": {
      "artifactName": "paper-reader-v${version}-portable.${ext}"
    }
  }
}
